# Sampada — Environment Configuration
# Copy this to .env and fill in values.

# ── Required ──────────────────────────────────────────────────────────
SECRET_KEY_BASE=
POSTGRES_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_DOMAIN=

# ── Database ──────────────────────────────────────────────────────────
POSTGRES_USER=sampada
POSTGRES_DB=sampada_production
DB_HOST=localhost
DB_PORT=5432

# ── Server ────────────────────────────────────────────────────────────
PORT=3002
RAILS_ENV=production
RAILS_MAX_THREADS=3
WEB_CONCURRENCY=1
BINDING=0.0.0.0

# ── SSL ───────────────────────────────────────────────────────────────
# Set true only if Nginx/Caddy handles SSL termination
RAILS_FORCE_SSL=false
RAILS_ASSUME_SSL=false

# ── Redis / Sidekiq ───────────────────────────────────────────────────
# canonical name in sops; compose derives REDIS_URL from it:
REDIS_HOST=10.0.1.46
SIDEKIQ_WEB_USERNAME=sampada
SIDEKIQ_WEB_PASSWORD=sampada

# ── SMTP (for emails & passwordless login) ────────────────────────────
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_ENABLED=false

# ── Rails Encryption (for encrypted columns) ──────────────────────────
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# ── Other ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://sampada.pages.dev

# ── Better-Auth ────────────────────────────────────────────────────────
BETTER_AUTH_VERIFY_URL=http://localhost:4000/api/auth/verify
BETTER_AUTH_APP_ID=sampada
BETTER_AUTH_CACHE_TTL=300

# ── Database Backup ─────────────────────────────────────────────────────
DATABASE_BACKUP_ENABLED=false
# DATABASE_BACKUP_S3_BUCKET=  # Optional: for S3/Minio upload
# DATABASE_BACKUP_S3_REGION=  # Optional
# DATABASE_BACKUP_S3_ACCESS_KEY=  # Optional
# DATABASE_BACKUP_S3_SECRET_KEY=  # Optional
