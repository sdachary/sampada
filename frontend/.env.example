# Data API (same origin via the Pages Functions proxy to sampada-api-production).
# Production Pages build sets this to /api/worker; leave it at that value.
VITE_API_URL=/api/worker

# Public Turnstile site key for the A8 magic-link request forms. Safe to expose
# in the browser bundle; the secret key belongs only in the Worker via SOPS.
VITE_TURNSTILE_SITE_KEY=
