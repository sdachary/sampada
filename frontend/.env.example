# Same-origin — CF Pages Functions proxy (functions/[[path]].js) forwards
# /api/worker/* to the sampada-api Worker and /api/auth/* to the legacy
# Better-Auth VM (being retired in A8).
VITE_API_URL=
VITE_BETTER_AUTH_URL=/auth/v2

# Public Turnstile site key for the A8 magic-link request form. Safe to expose
# in the browser bundle; the secret key belongs only in the Worker via SOPS.
VITE_TURNSTILE_SITE_KEY=
